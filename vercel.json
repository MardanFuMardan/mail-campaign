{
  "version": 2,
  "functions": {
    "api/*.js": {
      "includeFiles": "api/_private/**"
    }
  },
  "routes": [
    {
      "src": "^/api/_.*$",
      "dest": "/api/page?p=notfound"
    },
    {
      "src": "^/api/([^/]+)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/(?:index\\.html)?$",
      "dest": "/api/page?p=home"
    },
    {
      "src": "^/admin/?$",
      "dest": "/api/page?p=admin"
    },
    {
      "src": "/(.*)",
      "dest": "/api/page?p=notfound"
    }
  ]
}
